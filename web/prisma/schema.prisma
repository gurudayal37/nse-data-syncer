generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model announcements {
  id                Int       @id @default(autoincrement())
  stock_id          Int
  title             String    @db.VarChar(500)
  content           String?
  announcement_type String?   @db.VarChar(100)
  announcement_date DateTime  @db.Timestamp(6)
  filing_date       DateTime? @db.Timestamp(6)
  is_important      Boolean?
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  stocks            stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([announcement_type], map: "ix_announcements_announcement_type")
  @@index([id], map: "ix_announcements_id")
}

model concalls {
  id             Int       @id @default(autoincrement())
  stock_id       Int
  quarter        String    @db.VarChar(10)
  year           Int
  call_date      DateTime  @db.Timestamp(6)
  duration       Int?
  transcript_url String?   @db.VarChar(500)
  recording_url  String?   @db.VarChar(500)
  key_points     String?
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  stocks         stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_concalls_id")
}

model credit_ratings {
  id            Int       @id @default(autoincrement())
  stock_id      Int
  rating_agency String    @db.VarChar(100)
  rating        String    @db.VarChar(20)
  outlook       String?   @db.VarChar(20)
  rating_date   DateTime  @db.Timestamp(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  stocks        stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_credit_ratings_id")
}

model daily_prices {
  id                  Int       @id @default(autoincrement())
  stock_id            Int
  date                DateTime  @db.Timestamp(6)
  open_price          Float
  high_price          Float
  low_price           Float
  close_price         Float
  volume              BigInt?
  turnover            Float?
  vwap                Float?
  delivery_quantity   Int?
  delivery_percentage Float?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  stocks              stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([date], map: "ix_daily_prices_date")
  @@index([id], map: "ix_daily_prices_id")
  @@index([stock_id, date(sort: Desc)], map: "ix_daily_prices_stock_date")
}

model financial_statements {
  id              Int       @id @default(autoincrement())
  stock_id        Int
  statement_type  String    @db.VarChar(50)
  period          String    @db.VarChar(20)
  year            Int
  quarter         Int?
  data            String?
  is_consolidated Boolean?
  filing_date     DateTime? @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  stocks          stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_financial_statements_id")
}

model news {
  id              Int       @id @default(autoincrement())
  stock_id        Int
  title           String    @db.VarChar(500)
  content         String?
  source          String?   @db.VarChar(100)
  url             String?   @db.VarChar(500)
  sentiment_score Float?
  sentiment_label String?   @db.VarChar(20)
  published_date  DateTime  @db.Timestamp(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  stocks          stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([id], map: "ix_news_id")
}

model quarterly_results {
  id                    Int       @id @default(autoincrement())
  stock_id              Int
  quarter               String    @db.VarChar(10)
  year                  Int
  quarter_number        Int
  revenue               Float?
  net_profit            Float?
  ebitda                Float?
  operating_profit      Float?
  operating_margin      Float?
  net_margin            Float?
  eps                   Float?
  is_consolidated       Boolean?
  announcement_date     DateTime? @db.Timestamp(6)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  other_income          Decimal?  @db.Decimal(20, 2)
  total_income          Decimal?  @db.Decimal(20, 2)
  expenditure           Decimal?  @db.Decimal(20, 2)
  interest              Decimal?  @db.Decimal(20, 2)
  pbdt                  Decimal?  @db.Decimal(20, 2)
  depreciation          Decimal?  @db.Decimal(20, 2)
  pbt                   Decimal?  @db.Decimal(20, 2)
  tax                   Decimal?  @db.Decimal(20, 2)
  equity                Decimal?  @db.Decimal(20, 2)
  ceps                  Decimal?  @db.Decimal(20, 2)
  opm_percent           Decimal?  @db.Decimal(5, 2)
  npm_percent           Decimal?  @db.Decimal(5, 2)
  quarterly_result_link String?
  source                String?   @default("screener") @db.VarChar(20)
  filing_date           DateTime? @db.Date
  tax_percent           Float?
  expected_eps          Float?
  stocks                stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stock_id, quarter, year], map: "uq_quarterly_results_stock_quarter_year")
  @@index([id], map: "ix_quarterly_results_id")
  @@index([stock_id], map: "ix_quarterly_results_stock_id")
}

model shareholding_patterns {
  id               Int       @id @default(autoincrement())
  stock_id         Int
  quarter          String    @db.VarChar(10)
  year             Int
  quarter_number   Int
  promoter_holding Float?
  fii_holding      Float?
  dii_holding      Float?
  public_holding   Float?
  other_holding    Float?
  government_holding Float?
  num_shareholders Int?
  total_shares     Int?
  filing_date      DateTime? @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  stocks           stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stock_id, quarter, year], map: "uq_shareholding_stock_quarter_year")
  @@index([id], map: "ix_shareholding_patterns_id")
  @@index([stock_id], map: "ix_shareholding_stock_id")
}

model tag_master {
  id         Int      @id @default(autoincrement())
  name       String   @unique @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([name], map: "ix_tag_master_name")
}

model stock_tags {
  id         Int      @id @default(autoincrement())
  stock_id   Int
  tag        String   @db.VarChar(100)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  stocks     stocks   @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stock_id, tag], map: "uq_stock_tags_stock_tag")
  @@index([stock_id], map: "ix_stock_tags_stock_id")
  @@index([tag], map: "ix_stock_tags_tag")
}

model stock_notes {
  id         Int      @id @default(autoincrement())
  stock_id   Int
  note       String   @db.Text
  created_at DateTime @default(now()) @db.Timestamptz(6)
  stocks     stocks   @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([stock_id], map: "ix_stock_notes_stock_id")
}

model stocks {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(255)
  isin                  String?                 @unique(map: "ix_stocks_isin") @db.VarChar(20)
  bse_symbol            String?                 @unique(map: "ix_stocks_bse_symbol") @db.VarChar(20)
  nse_symbol            String?                 @unique(map: "ix_stocks_nse_symbol") @db.VarChar(20)
  current_price         Float?
  market_cap            BigInt?
  face_value            Float?
  high_52_week          Float?
  low_52_week           Float?
  pe_ratio              Float?
  pb_ratio              Float?
  book_value            Float?
  dividend_yield        Float?
  roce                  Float?
  roe                   Float?
  industry              String?                 @db.VarChar(100)
  sector                String?                 @db.VarChar(100)
  subsector             String?                 @db.VarChar(100)
  subsector1            String?                 @db.VarChar(100)
  subsector2            String?                 @db.VarChar(100)
  subsector3            String?                 @db.VarChar(100)
  is_active             Boolean?
  created_at            DateTime?               @db.Timestamp(6)
  updated_at            DateTime?               @db.Timestamp(6)
  last_updated          DateTime?               @db.Timestamp(6)
  long_business_summary String?
  announcements         announcements[]
  concalls              concalls[]
  credit_ratings        credit_ratings[]
  daily_prices          daily_prices[]
  financial_statements  financial_statements[]
  news                  news[]
  quarterly_results     quarterly_results[]
  shareholding_patterns shareholding_patterns[]
  stock_performance     stock_performance?
  stock_tags            stock_tags[]
  stock_notes           stock_notes[]
  stage2_changes        stage2_changes[]
  sync_tracker          sync_tracker[]

  @@index([id], map: "ix_stocks_id")
}

model sync_tracker {
  id             Int       @id @default(autoincrement())
  stock_id       Int
  data_type      String    @db.VarChar(50)
  last_sync_time DateTime? @db.Timestamp(6)
  last_data_date DateTime? @db.Timestamp(6)
  records_count  Int?
  sync_status    String?   @db.VarChar(20)
  error_message  String?
  created_at     DateTime? @db.Timestamp(6)
  updated_at     DateTime? @db.Timestamp(6)
  stocks         stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([stock_id, data_type], map: "uq_stock_data_type")
  @@index([id], map: "ix_sync_tracker_id")
}

model stock_performance {
  id                       Int       @id @default(autoincrement())
  stock_id                 Int       @unique
  change_1w                Float?
  change_1m                Float?
  change_3m                Float?
  change_1y                Float?
  change_5y                Float?
  updated_at               DateTime? @default(now()) @db.Timestamp(6)
  daily_volume             BigInt?
  change_3y                Float?
  change_6m                Float?
  momentum_score           Float?
  mr_1m                    Float?
  mr_1y                    Float?
  mr_3m                    Float?
  mr_6m                    Float?
  volatility               Float?
  z_1m                     Float?
  z_1y                     Float?
  z_3m                     Float?
  z_6m                     Float?
  simple_momentum_score    Float?
  is_vcp                   Boolean?  @default(false)
  vcp_score                Float?
  is_stage2                Boolean?  @default(false)
  stage2_rs_rank           Float?
  stage2_pct_from_52w_high Float?
  stage2_pct_above_52w_low Float?
  adr_pct                  Float?
  strong_stock_score       Float?
  sector_score             Float?
  adr_score                Float?
  swing_score              Float?
  stocks                   stocks    @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([change_1w])
  @@index([change_1m])
  @@index([change_3m])
  @@index([change_6m])
  @@index([change_1y])
  @@index([change_3y])
  @@index([change_5y])
  @@index([daily_volume])
  @@index([is_vcp])
}

model stage2_changes {
  id          Int      @id @default(autoincrement())
  stock_id    Int
  nse_symbol  String
  stock_name  String
  change_type String   // 'added' | 'removed'
  run_date    DateTime @db.Date

  stocks      stocks   @relation(fields: [stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([run_date])
  @@index([stock_id])
}

model momentum_history {
  id             Int      @id @default(autoincrement())
  stock_id       Int
  date           DateTime @db.Date
  momentum_score Float?
  rank           Int?

  @@unique([stock_id, date], map: "idx_momentum_history_stock_date")
}

model market_breadth_history {
  date             DateTime @id @db.Date
  total            Int?
  advances         Int?
  declines         Int?
  unchanged        Int?
  near_52w_high    Int?
  near_52w_low     Int?
  pct_above_ema20  Float?
  pct_above_ema50  Float?
  pct_above_ema200 Float?
  new_highs        Int?
  new_lows         Int?
  net_highs_lows   Int?
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
}

model etfs {
  id               Int                @id @default(autoincrement())
  symbol           String             @unique @db.VarChar(50)
  name             String?            @db.VarChar(255)
  underlying_asset String?            @db.VarChar(255)
  nav              Float?
  is_active        Int?               @default(1)
  security_id      Int?
  isin             String?            @db.VarChar(20)
  series           String?            @db.VarChar(10)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  etf_daily_prices etf_daily_prices[]
  etf_performance  etf_performance?

  @@index([id], map: "ix_etfs_id")
  @@index([symbol], map: "ix_etfs_symbol")
}

model etf_daily_prices {
  id          Int       @id @default(autoincrement())
  etf_id      Int
  date        DateTime  @db.Timestamp(6)
  open_price  Float
  high_price  Float
  low_price   Float
  close_price Float
  volume      BigInt?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  etfs        etfs      @relation(fields: [etf_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([date], map: "ix_etf_daily_prices_date")
  @@index([id], map: "ix_etf_daily_prices_id")
  @@index([etf_id, date(sort: Desc)], map: "ix_etf_daily_prices_etf_date")
}

model etf_performance {
  id           Int       @id @default(autoincrement())
  etf_id       Int       @unique
  change_1w    Float?
  change_1m    Float?
  change_3m    Float?
  change_6m    Float?
  change_1y    Float?
  change_3y    Float?
  change_5y     Float?
  daily_volume  BigInt?
  avg_range_20d Float?
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  etfs          etfs      @relation(fields: [etf_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([change_1w])
  @@index([change_1m])
  @@index([change_3m])
  @@index([change_6m])
  @@index([change_1y])
  @@index([change_3y])
  @@index([change_5y])
  @@index([daily_volume])
  @@index([avg_range_20d])
}

model sme_stocks {
  id               Int                @id @default(autoincrement())
  symbol           String             @unique @db.VarChar(50)
  name             String?            @db.VarChar(255)
  isin             String?            @db.VarChar(20)
  security_id      Int?
  series           String?            @db.VarChar(5)
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @db.Timestamp(6)
  sme_daily_prices sme_daily_prices[]
  sme_performance  sme_performance?

  @@index([id], map: "ix_sme_stocks_id")
  @@index([symbol], map: "ix_sme_stocks_symbol")
}

model sme_daily_prices {
  id           Int        @id @default(autoincrement())
  sme_stock_id Int
  date         DateTime   @db.Timestamp(6)
  open_price   Float?
  high_price   Float?
  low_price    Float?
  close_price  Float?
  volume       BigInt?
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  sme_stocks   sme_stocks @relation(fields: [sme_stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([sme_stock_id, date], map: "ix_sme_daily_prices_stock_date")
  @@index([date], map: "ix_sme_daily_prices_date")
  @@index([id], map: "ix_sme_daily_prices_id")
  @@index([sme_stock_id, date(sort: Desc)], map: "ix_sme_daily_prices_stock_date_idx")
}

model sme_performance {
  id           Int        @id @default(autoincrement())
  sme_stock_id Int        @unique
  change_1w    Float?
  change_1m    Float?
  change_3m    Float?
  change_6m    Float?
  change_1y    Float?
  change_3y    Float?
  change_5y    Float?
  daily_volume BigInt?
  updated_at   DateTime?  @default(now()) @db.Timestamp(6)
  sme_stocks   sme_stocks @relation(fields: [sme_stock_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([change_1w])
  @@index([change_1m])
  @@index([change_3m])
  @@index([change_6m])
  @@index([change_1y])
  @@index([change_3y])
  @@index([change_5y])
  @@index([daily_volume])
}

model us_stocks {
  id               Int                @id @default(autoincrement())
  ticker           String             @unique @db.VarChar(20)
  name             String?            @db.VarChar(255)
  sector           String?            @db.VarChar(100)
  is_active        Boolean?           @default(true)
  created_at       DateTime?          @default(now()) @db.Timestamptz(6)
  us_daily_prices  us_daily_prices[]
  us_performance   us_performance?

  @@index([id], map: "ix_us_stocks_id")
  @@index([ticker], map: "ix_us_stocks_ticker")
}

model us_daily_prices {
  id          Int       @id @default(autoincrement())
  us_stock_id Int
  date        DateTime  @db.Date
  open_price  Float?
  high_price  Float?
  low_price   Float?
  close_price Float?
  volume      BigInt?
  us_stocks   us_stocks @relation(fields: [us_stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([us_stock_id, date], map: "ix_us_daily_prices_stock_date")
  @@index([date], map: "ix_us_daily_prices_date")
  @@index([us_stock_id, date(sort: Desc)], map: "ix_us_daily_prices_stock_date_idx")
}

model us_performance {
  id           Int       @id @default(autoincrement())
  us_stock_id  Int       @unique
  change_1w    Float?
  change_1m    Float?
  change_3m    Float?
  change_6m    Float?
  change_1y    Float?
  change_3y    Float?
  change_5y    Float?
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  us_stocks    us_stocks @relation(fields: [us_stock_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([change_1w])
  @@index([change_1m])
  @@index([change_3m])
  @@index([change_6m])
  @@index([change_1y])
  @@index([change_3y])
  @@index([change_5y])
}

model index_daily_prices {
  id          Int       @id @default(autoincrement())
  index_id    Int
  date        DateTime  @db.Timestamp(6)
  open_price  Float?
  high_price  Float?
  low_price   Float?
  close_price Float?
  volume      BigInt?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  indices     indices   @relation(fields: [index_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([index_id, date], map: "ix_index_daily_prices_index_date")
  @@index([date], map: "ix_index_daily_prices_date")
  @@index([id], map: "ix_index_daily_prices_id")
  @@index([index_id, date(sort: Desc)], map: "ix_index_daily_prices_index_date_idx")
}

model index_performance {
  id           Int       @id @default(autoincrement())
  index_id     Int       @unique
  change_1w    Float?
  change_1m    Float?
  change_3m    Float?
  change_6m    Float?
  change_1y    Float?
  change_3y    Float?
  change_5y    Float?
  daily_volume BigInt?
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
  indices      indices   @relation(fields: [index_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([change_1m], map: "idx_index_perf_change_1m")
  @@index([change_1w], map: "idx_index_perf_change_1w")
  @@index([change_1y], map: "idx_index_perf_change_1y")
  @@index([change_3m], map: "idx_index_perf_change_3m")
  @@index([change_3y], map: "idx_index_perf_change_3y")
  @@index([change_5y], map: "idx_index_perf_change_5y")
  @@index([change_6m], map: "idx_index_perf_change_6m")
  @@index([daily_volume], map: "idx_index_perf_daily_volume")
}

model indices {
  id                 Int                  @id @default(autoincrement())
  symbol             String               @unique @db.VarChar(50)
  name               String?              @db.VarChar(255)
  is_active          Int?                 @default(1)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @db.Timestamp(6)
  index_daily_prices index_daily_prices[]
  index_performance  index_performance?

  @@index([id], map: "ix_indices_id")
  @@index([symbol], map: "ix_indices_symbol")
}

enum tradedirection {
  long
  short
}

enum tradestatus {
  placed
  executed
  closed
}

model result_analyses {
  id            Int      @id @default(autoincrement())
  symbol        String   @db.VarChar(20)
  result_date   DateTime @db.Date
  seq_id        String?  @db.VarChar(50)
  pdf_url       String?  @db.Text
  revenue            Decimal? @db.Decimal(15, 2)
  ebit               Decimal? @db.Decimal(15, 2)
  net_profit         Decimal? @db.Decimal(15, 2)
  eps                Decimal? @db.Decimal(10, 2)
  revenue_yoy_pct    Decimal? @db.Decimal(8, 2)
  net_profit_yoy_pct Decimal? @db.Decimal(8, 2)
  quarter_label      String?  @db.VarChar(50)
  is_consolidated    Boolean? @default(false)
  signal             String?  @db.VarChar(10)
  confidence         String?  @db.VarChar(10)
  key_positives      String?  @db.Text
  key_negatives      String?  @db.Text
  reasoning          String?  @db.Text
  analysed_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([symbol, result_date], map: "uq_result_analyses_symbol_date")
  @@index([result_date], map: "ix_result_analyses_date")
}

model board_meetings {
  id           Int       @id @default(autoincrement())
  symbol       String    @db.VarChar(20)
  company_name String?   @db.VarChar(500)
  meeting_date DateTime  @db.Date
  purpose      String?   @db.VarChar(500)
  bm_desc      String?
  attachment   String?   @db.VarChar(1000)
  sm_isin      String?   @db.VarChar(20)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([symbol, meeting_date], map: "uq_board_meetings_symbol_date")
  @@index([id], map: "ix_board_meetings_id")
  @@index([meeting_date], map: "ix_board_meetings_date")
}
